{
  "name": "countries-list-as-georgian",
  "version": "2.0.0",
  "description": "Countries list with flags ( English/Georgian )",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunkman32/countries-list-as-georgian.git"
  },
  "keywords": [
    "countries-list-as-georgian",
    "latinToGeorgian",
    "EnglishToGeorgian",
    "transliteration",
    "Georgian",
    "ქართული",
    "ინგლისური",
    "countries list",
    "ქვეყნების სია",
    "typescript",
    "types"
  ],
  "author": "nozza - dunkman32",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dunkman32/countries-list-as-georgian/issues"
  },
  "homepage": "https://github.com/dunkman32/countries-list-as-georgian#readme",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
